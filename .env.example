# LLM
# groq | claude
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
# modèle Groq — vérifier qu'il existe toujours : GET https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b

# Apify
APIFY_API_TOKEN=apify_api_...
# optionnel — second compte Apify, utilisé quand le premier a épuisé son quota
APIFY_FALLBACK_API_TOKEN=
# mock | real — mock utilise les fixtures JSON, aucun token requis
APIFY_PROVIDER=mock
# plafond de posts scrapés par query et par run (Apify facture au post)
APIFY_MAX_POSTS_PER_QUERY=20

# Base de données
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/mission_radar

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Planification (Celery Beat)
# intervalle entre deux exécutions du pipeline collecte/analyse/digest
DISPATCH_INTERVAL_HOURS=24

# Observabilité
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Email
RESEND_API_KEY=re_...
# expéditeur du digest quotidien — doit être un domaine/adresse vérifié Resend
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME=Mission Radar AI
# active l'envoi du digest quotidien (Phase 7)
DIGEST_ENABLED=false

# App
# development | production
APP_ENV=development

# MCP
# identité mockée du pilote stdio local (Phase 10.0, server.py) — UUID du UserProfile — inchangé par la Phase 10.4 (le mount HTTP utilise Auth0)
MISSION_RADAR_PROFILE_ID=00000000-0000-0000-0000-000000000000

# Auth0 (Phase 10.4) — voir README section "Phase 10.4.1 — Configuration Auth0" pour le guide de configuration du tenant
# Applications > APIs, valeur "Domain" du tenant
AUTH0_DOMAIN=your-tenant.eu.auth0.com
# Identifier de l'API Auth0 "Mission Radar AI - REST API"
AUTH0_API_AUDIENCE=https://api.mission-radar.dev
# Identifier de l'API Auth0 "Mission Radar AI - MCP Server" — distinct de AUTH0_API_AUDIENCE (RFC 8707, anti confused-deputy)
AUTH0_MCP_AUDIENCE=https://api.mission-radar.dev/mcp
# Phase 10.4.5 — annoncé dans le challenge WWW-Authenticate du mount /mcp
MCP_PROTECTED_RESOURCE_METADATA_URL=http://localhost:8000/.well-known/oauth-protected-resource
