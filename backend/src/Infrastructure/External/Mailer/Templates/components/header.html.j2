<tr>
  <td style="padding:28px 32px 16px;border-bottom:1px solid #e5e7eb;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
      <tr>
        <td>
          <span style="font-size:20px;font-weight:bold;color:#4f46e5;">⚡ Mission Radar AI</span>
        </td>
        <td align="right">
          <span style="font-size:12px;color:#9ca3af;">
            {{ digest.generated_at.strftime('%d/%m/%Y') }}
          </span>
        </td>
      </tr>
    </table>
    <p style="margin:12px 0 0;font-size:18px;font-weight:bold;color:#111827;">
      {{ digest.subject.split(' — ')[1] if ' — ' in digest.subject else digest.subject }}
    </p>
    <p style="margin:4px 0 0;font-size:14px;color:#6b7280;">
      Bonjour {{ digest.user_name }} 👋
    </p>
  </td>
</tr>
