# Référence des variables à renseigner dans Coolify (Application → Environment
# Variables) pour docker-compose.prod.yml. Ne pas committer de vraies valeurs.

# Domaine public (label Traefik du service frontend + DNS)
DEPLOY_DOMAIN=mission-radar.stefanoalletti.com

# Intervalle entre deux exécutions du pipeline collecte/analyse/digest — optionnel,
# défaut 24 (heures) si non défini, pas besoin de la saisir dans Coolify sauf pour changer la cadence
DISPATCH_INTERVAL_HOURS=24

# Base de données — mot de passe du rôle "mission_radar", pas de valeur par défaut en prod
POSTGRES_PASSWORD=change-me

# RabbitMQ — identifiants dédiés, ne jamais garder guest/guest en prod
RABBITMQ_USER=change-me
RABBITMQ_PASSWORD=change-me

# LLM — décidé pour la prod : Groq (voir README pour Claude si ça change un jour)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...

# Apify — token réel + provider "real" (le provider "mock" est réservé au dev/CI)
APIFY_API_TOKEN=apify_api_...
APIFY_PROVIDER=real

# Email (Resend) — domaine d'envoi déjà vérifié
RESEND_API_KEY=re_...
MAIL_FROM=onboarding@stefanoalletti.com
MAIL_FROM_NAME=Mission Radar AI
DIGEST_ENABLED=true

# Observabilité
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Auth0 — tenant/ressources de prod à créer, voir docs/DEPLOYMENT.md
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_API_AUDIENCE=https://api.mission-radar.dev
AUTH0_MCP_AUDIENCE=https://api.mission-radar.dev/mcp
MCP_PROTECTED_RESOURCE_METADATA_URL=https://mission-radar.stefanoalletti.com/.well-known/oauth-protected-resource
AUTH0_WEB_CLIENT_ID=...     # Client ID de "Mission Radar AI - Web", utilisé au build du frontend (VITE_AUTH0_CLIENT_ID)
