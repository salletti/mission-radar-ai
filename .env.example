# LLM
LLM_PROVIDER=groq                    # groq | claude
GROQ_API_KEY=gsk_...

# Apify
APIFY_API_TOKEN=apify_api_...
APIFY_PROVIDER=mock                  # mock | real — mock utilise les fixtures JSON, aucun token requis

# Base de données
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/mission_radar

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Observabilité
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Email
RESEND_API_KEY=re_...
MAIL_FROM=onboarding@resend.dev      # expéditeur du digest quotidien — doit être un domaine/adresse vérifié Resend
MAIL_FROM_NAME=Mission Radar AI
DIGEST_ENABLED=false                 # active l'envoi du digest quotidien (Phase 7)

# App
APP_ENV=development                  # development | production

# MCP
MISSION_RADAR_PROFILE_ID=00000000-0000-0000-0000-000000000000   # identité mockée du pilote stdio local (Phase 10.0, server.py) — UUID du UserProfile — inchangé par la Phase 10.4 (le mount HTTP utilise Auth0)

# Auth0 (Phase 10.4) — voir README section "Phase 10.4.1 — Configuration Auth0" pour le guide de configuration du tenant
AUTH0_DOMAIN=your-tenant.eu.auth0.com          # Applications > APIs, valeur "Domain" du tenant
AUTH0_API_AUDIENCE=https://api.mission-radar.dev       # Identifier de l'API Auth0 "Mission Radar AI - REST API"
AUTH0_MCP_AUDIENCE=https://api.mission-radar.dev/mcp   # Identifier de l'API Auth0 "Mission Radar AI - MCP Server" — distinct de AUTH0_API_AUDIENCE (RFC 8707, anti confused-deputy)
MCP_PROTECTED_RESOURCE_METADATA_URL=http://localhost:8000/.well-known/oauth-protected-resource   # Phase 10.4.5 — annoncé dans le challenge WWW-Authenticate du mount /mcp
